datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum ApplicationStatus {
  DISCOVERED
  SCORED
  QUEUED
  APPLYING
  APPLIED
  NEEDS_REVIEW
  INTERVIEW
  REJECTED
  FAILED
}

enum ApplicationMode {
  AUTOMATIC
  ASSISTED
}

enum MatchLevel {
  HIGH_MATCH
  MEDIUM_MATCH
  LOW_MATCH
}

model User {
  id               String            @id @default(uuid())
  email            String            @unique
  name             String?
  passwordHash     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  candidateProfile CandidateProfile?
  applications     Application[]
}

model CandidateProfile {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  rawCvText             String   @db.Text

  // Contact & Socials
  fullName              String?
  phone                 String?
  currentLocation       String?
  portfolioUrl          String?
  githubUrl             String?
  linkedinUrl           String?

  // Job Target & Geo Preferences
  targetCountry         String?  @default("India")
  targetCities          String[] @default([])
  targetJobTitles       String[] @default([])
  preferredWorkplace    String?  @default("REMOTE")

  // Compensation & Currency
  preferredCurrency     String?  @default("INR")
  compensationFormat    String?  @default("LPA")
  expectedSalary        String?
  minSalaryFloor        String?
  openToEquity          Boolean? @default(true)

  // Work Model & Availability
  employmentTypes       String[] @default(["Full-time"])
  noticePeriod          String?
  noticePeriodBuyout    Boolean? @default(false)
  workAuthorization     String?
  timezonePreference    String?  @default("IST")
  relocationPreference  String?  @default("NO_RELOCATION")
  seniorityLevel        String?  @default("SENIOR")
  excludedCompanies     String[] @default([])

  // Skills, History & Screening
  extractedSkills       String[]
  workExperience        Json     @default("[]")
  education             Json     @default("[]")
  certifications        Json     @default("[]")
  preVerifiedAnswers    Json     @default("{}")

  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model JobPosting {
  id              String            @id @default(uuid())
  externalId      String
  sourceProvider  String
  title           String
  company         String
  location        String?
  workplaceType   String?           @default("REMOTE")
  description     String            @db.Text
  externalUrl     String
  salaryRange     String?
  applicationMode ApplicationMode   @default(AUTOMATIC)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  matchScores     JobMatchScore[]
  applications    Application[]

  @@unique([sourceProvider, externalId])
}

model JobMatchScore {
  id            String     @id @default(uuid())
  jobPostingId  String
  jobPosting    JobPosting @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  score         Int
  reasoning     String     @db.Text
  matchedSkills String[]
  missingSkills String[]
  matchLevel    MatchLevel
  createdAt     DateTime   @default(now())

  @@index([jobPostingId])
}

model Application {
  id                   String            @id @default(uuid())
  userId               String
  user                 User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobPostingId         String
  jobPosting           JobPosting        @relation(fields: [jobPostingId], references: [id], onDelete: Cascade)
  status               ApplicationStatus @default(DISCOVERED)
  mode                 ApplicationMode   @default(AUTOMATIC)
  generatedCoverLetter String?           @db.Text
  generatedAnswers     Json              @default("{}")
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  logs                 ApplicationLog[]

  @@index([userId])
  @@index([jobPostingId])
  @@index([status])
}

model ApplicationLog {
  id            String      @id @default(uuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  step          String
  details       String      @db.Text
  createdAt     DateTime    @default(now())

  @@index([applicationId])
}
